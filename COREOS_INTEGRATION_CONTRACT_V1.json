    "objective",
    "constraints",
    "available_capabilities",
    "authority",
    "budget",
    "state_reference",
    "providers"
  ],
  "provider_interfaces": [
    "CapabilityProvider",
    "StateProvider",
    "ResourceProvider",
    "AuthorityProvider",
    "TelemetryProvider",
    "ActionProvider",
    "EvidenceSink"
  ],
  "outputs": [
